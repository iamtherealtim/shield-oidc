{
    "name": "daemonlabs/shield-oidc",
    "description": "OpenID Connect single sign-on for CodeIgniter Shield: Microsoft Entra ID, Okta, Google Workspace, Keycloak, Auth0 and any other OIDC provider.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "codeigniter",
        "codeigniter4",
        "shield",
        "oidc",
        "openid-connect",
        "sso",
        "entra-id",
        "azure-ad",
        "okta",
        "keycloak"
    ],
    "authors": [
        {
            "name": "Daemon Labs",
            "email": "hello@daemonlabs.app",
            "homepage": "https://www.daemonlabs.app"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "codeigniter4/shield": "^1.1"
    },
    "require-dev": {
        "codeigniter4/framework": "^4.5",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "DaemonLabs\\ShieldOidc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "conflict": {
        "codeigniter4/framework": "<4.5"
    }
}
